{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "customManagers:biomeVersions"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "AOE Renovate Dependency Dashboard",
  "dependencyDashboardApproval": true,
  "gitAuthor": "aoe-renovate[bot] <201958700+aoe-renovate[bot]@users.noreply.github.com>",
  "branchPrefix": "github-renovate/",
  "timezone": "Europe/Helsinki",
  "forkProcessing": "disabled",
  "minimumReleaseAge": "7 days",
  "prCreation": "immediate",
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "schedule": ["* 0-4,17-23 * * 1-5", "* * * * 0,6"],
  "updateNotScheduled": false,
  "automergeSchedule": ["at any time"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "automerge": true,
    "dependencyDashboardApproval": false
  },
  "enabledManagers": [
    "nvm",
    "npm",
    "github-actions",
    "docker-compose",
    "dockerfile",
    "custom.jsonata"
  ],
  "github-actions": {
    "automerge": true,
    "dependencyDashboardApproval": false
  },
  "dockerfile": {
    "automerge": true,
    "dependencyDashboardApproval": false
  },
  "docker-compose": {
    "automerge": true,
    "dependencyDashboardApproval": false
  },
  "packageRules": [
    {
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "7 days"
    },
    {
      "automerge": true,
      "dependencyDashboardApproval": false,
      "groupName": "Angular framework",
      "matchPackageNames": ["/^@angular/"]
    },
    {
      "automerge": true,
      "dependencyDashboardApproval": false,
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance",
        "rollback",
        "bump",
        "replacement"
      ],
      "matchPackageNames": ["*"]
    },
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "dependencyDashboardApproval": false
    },
    {
      "groupName": "Bootstrap",
      "matchPackageNames": ["bootstrap"]
    },
    {
      "groupName": "Multer",
      "matchPackageNames": ["multer", "@types/multer"]
    },
    {
      "groupName": "Compression",
      "matchPackageNames": ["compression", "@types/compression"]
    },
    {
      "groupName": "Connect Redis",
      "matchPackageNames": ["connect-redis", "@types/connect-redis"]
    },
    {
      "groupName": "CORS",
      "matchPackageNames": ["cors", "@types/cors"]
    },
    {
      "groupName": "Express Session",
      "matchPackageNames": ["express-session", "@types/express-session"]
    },
    {
      "groupName": "jsonwebtoken",
      "matchPackageNames": ["jsonwebtoken", "@types/jsonwebtoken"]
    },
    {
      "groupName": "knip",
      "matchPackageNames": ["knip"]
    },
    {
      "groupName": "Mime",
      "matchPackageNames": ["mime"]
    },
    {
      "groupName": "Morgan",
      "matchPackageNames": ["morgan", "@types/morgan"]
    },
    {
      "groupName": "Passport",
      "matchPackageNames": ["passport", "@types/passport"]
    },
    {
      "groupName": "Redis",
      "matchPackageNames": ["redis", "@types/redis"]
    },
    {
      "groupName": "Node.js",
      "matchManagers": ["nvm", "npm"],
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["minor", "patch"]
    },
    {
      "groupName": "npm transitive overrides",
      "matchDepTypes": ["overrides", "resolutions"],
      "automerge": false,
      "dependencyDashboardApproval": false,
      "labels": ["overrides"]
    }
  ],
  "prConcurrentLimit": 10
}
