{
  "compileOnSave": false,
  "compilerOptions": {
    "declaration": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "module": "es2020",
    "moduleResolution": "bundler",
    "outDir": "./dist/out-tsc",
    "skipLibCheck": true,
    "sourceMap": true,
    "strict": false,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "paths": {
      "@components/*": [
        "./src/app/components/*"
      ],
      "@models/*": [
        "./src/app/models/*"
      ],
      "@services/*": [
        "./src/app/services/*"
      ],
      "@admin/*": [
        "./src/app/admin/*"
      ],
      "@constants/*": [
        "./src/app/constants/*"
      ],
      "@shared/*": [
        "./src/app/shared/*"
      ]
    },
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "strictTemplates": true
  }
}
